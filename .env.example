# Copy this file to .env and fill it in. Never commit .env.

# Anthropic API (set a spend limit in the Anthropic Console first)
ANTHROPIC_API_KEY=
DOMINO_MODEL=claude-opus-5-5
DOMINO_EFFORT=medium
DOMINO_MAX_TOOL_CALLS=30

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_IMAGE=falkordb/falkordb@sha256:b0bdcac2cbaff989e77cb0610439b7a9289e86de033ccbbd4368b66fb680ae7a   # graph module 42201; pinned after the M1 spike (docs/SPIKE.md)

# World
WORLD_SEED=42
WORLD_GRAPH_PRISTINE=world:pristine
WORLD_GRAPH_LIVE=world:live
MEMORY_GRAPH=memory

# MCP (external clients such as Claude Desktop need this key for write tools)
MCP_API_KEY=

# Public demo protection
LIVE_RUNS_PER_HOUR_PER_IP=5
